# Frontend runtime config for Docker deployment
# Copy to .env locally if needed, or pass these as environment variables to the container.

API_URL=http://localhost:8080/api
GOOGLE_CLIENT_ID=
REACT_APP_DEMO_MODE=false

# Example for real deployment:
# API_URL=https://api-tu-dominio.com/api
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# REACT_APP_DEMO_MODE=false (build-time setting; keep false in production)
